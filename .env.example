# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=regexdb
POSTGRES_USER=regex
POSTGRES_PASSWORD=regexpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (broker + result backend + cache) --------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally, real AWS S3 by dropping S3_ENDPOINT_URL) -
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=regex-data
S3_RAW_PREFIX=raw/
S3_RESULT_PREFIX=results/
S3_USE_SSL=0
S3_PATH_STYLE=1

# --- Spark ------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_HOST=celery-worker
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1500m
SPARK_EXECUTOR_CORES=2
SPARK_SHUFFLE_PARTITIONS=8
SPARK_MAX_PARTITION_BYTES=64m
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_MAX_RECORDS_PER_FILE=100000
SPARK_LOG_LEVEL=WARN
EXCEL_MAX_BYTES=104857600

# --- LLM --------------------------------------------------------------------
# gemini | anthropic | openai -- only the matching API key below is required.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Reasoning tokens are drawn from this same budget, so keep it generous:
# too low truncates the JSON answer mid-string.
GEMINI_MAX_OUTPUT_TOKENS=8192
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_OUTPUT_TOKENS=8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_OUTPUT_TOKENS=8192
LLM_CACHE_TTL_SECONDS=604800
LLM_TIMEOUT_SECONDS=30

# --- Safety limits ----------------------------------------------------------
REGEX_MAX_LENGTH=2000
REGEX_TIMEOUT_MS=1000
API_MAX_PAGE_SIZE=500

# --- seeding ----------------------------------------------------------------
# Rows in the scale-test CSV. Set to 0 to skip it, or lower it on a small laptop.
SEED_LARGE_ROWS=2000000
SEED_FORCE=0
