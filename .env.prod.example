# ---------------------------------------------------------------------------
# Copy to .env.prod (gitignored, never committed). deploy.sh reads it for
# values a human chooses that legitimately differ between local dev and this
# deployment -- e.g. a separate Gemini key/quota so a demo deploy can't burn
# through your dev budget.
#
# NOT here: DB password, Django secret key, Flower basic auth. Those are
# machine-generated secrets deploy.sh creates itself and keeps only on the
# instance -- there is nothing to fill in for them, in this file or any other.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# Optional -- uncomment to run a different model in prod than locally.
# GEMINI_MODEL=gemini-3.6-flash

# Optional -- uncomment to change the scale-test row count for this deploy.
# SEED_LARGE_ROWS=2000000
