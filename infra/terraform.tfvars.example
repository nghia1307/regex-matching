# Copy to terraform.tfvars and edit.

# Lock SSH to your own address. Find it with:
#   curl -s https://checkip.amazonaws.com
admin_cidrs = ["203.0.113.10/32"]

# Flower has HTTP basic auth. Restrict it to yourself, or open it to
# ["0.0.0.0/0"] if a reviewer should be able to see the task monitoring.
flower_cidrs = ["203.0.113.10/32"]

# t3.large (2 vCPU / 8 GB) is the practical minimum. ~$61/month running 24/7.
instance_type = "t3.large"

region = "us-east-1"

# Arms an AWS Budgets alert -- worth it for a stack that stays up.
budget_alert_email = "you@example.com"
budget_limit_usd   = 80
